// Composition for the tls-virt demo rig.
//
// Three components, one chain: the demo app speaks plain `wasi:sockets`;
// its sockets imports are rewired by explicit assignment onto the
// virtualizer's exports of the same interfaces, while the virtualizer's
// own `wasi:sockets` imports pass through to the host; the virtualizer
// tunnels suffix-opted connections through the `polymorph:tls` client.
package polymorph:tls-virt-composed;

// The TLS provider. Its wasi imports pass through to the host.
let tls = new polymorph:tls-component { ... };

// The virtualizer: TLS from the `polymorph:tls` instance; real sockets and
// name lookup from the host.
let virt = new polymorph:tls-virt-guest {
    "polymorph:tls/types@0.1.0": tls["polymorph:tls/types@0.1.0"],
    "polymorph:tls/client@0.1.0": tls["polymorph:tls/client@0.1.0"],
    ...
};

// The demo app: every socket it can see is the virtualizer's.
let demo = new polymorph:tls-virt-demo {
    "wasi:sockets/types@0.3.0": virt["wasi:sockets/types@0.3.0"],
    "wasi:sockets/ip-name-lookup@0.3.0": virt["wasi:sockets/ip-name-lookup@0.3.0"],
    ...
};

export demo["wasi:cli/run@0.3.0"];
