package polymorph:tls-virt@0.1.0;

/// A `wasi:sockets` virtualizer that adds TLS transparently.
///
/// The world imports and exports the same sockets interfaces: the
/// exports face the composed application, the imports face the host.
/// Composition wires the application's `wasi:sockets` imports onto
/// this component's exports by explicit assignment; the component's
/// own imports pass through. See compose.wac.
world virtualizer {
    import wasi:sockets/types@0.3.0;
    import wasi:sockets/ip-name-lookup@0.3.0;
    import polymorph:tls/types@0.1.0;
    import polymorph:tls/client@0.1.0;

    export wasi:sockets/types@0.3.0;
    export wasi:sockets/ip-name-lookup@0.3.0;
}
