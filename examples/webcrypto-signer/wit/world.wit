package polymorph:webcrypto-signer@0.1.0;

/// Adapts a `polymorph:webcrypto` signing provider to `polymorph:tls/signer`: the
/// TLS identity's Ed25519 key lives behind a webcrypto signing-key
/// handle, wherever the composed provider keeps it.
world shim {
    import polymorph:webcrypto/ed25519-sign@0.1.0;
    export polymorph:tls/signer@0.1.0;
}
